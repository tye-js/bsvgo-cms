{
  "name": "bsvgo-cms",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p ${PORT:-3100}",
    "build": "next build",
    "start": "next start -p ${PORT:-3100}",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env --import tsx scripts/migrate-admin.ts",
    "db:push": "node --env-file=.env ./node_modules/.bin/drizzle-kit push",
    "db:studio": "node --env-file=.env ./node_modules/.bin/drizzle-kit studio",
    "db:seed": "node --env-file=.env --import tsx scripts/seed.ts",
    "admin:verify": "node --env-file=.env --import tsx scripts/verify-admin.ts"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "argon2": "^0.44.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.561.0",
    "next": "^16.2.6",
    "postgres": "^3.4.9",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.5",
    "zod": "^4.4.3"
  },
  "overrides": {
    "postcss": "^8.5.14"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3"
  }
}
